# Used only by the Vercel serverless function in api/chat.ts. Never expose these in VITE_* variables.
HF_API_KEY=hf_your_hugging_face_token
TAVILY_API_KEY=tvly_your_tavily_search_key

# Optional fallback when Hugging Face credits are exhausted. Keep this server-side.
GROQ_API_KEY=gsk_your_groq_api_key
# Default model available on Groq Free Plan; keep the account on Free Plan.
GROQ_MODEL=openai/gpt-oss-20b
