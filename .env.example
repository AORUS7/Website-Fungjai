# Server-side only. Never put provider keys in VITE_* variables.
TAVILY_API_KEY=tvly_your_tavily_search_key

# Add only the providers you want to enable. Missing keys are skipped.
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=your_openrouter_key
# OpenRouter is fixed to openrouter/free; no automatic paid-model fallback.
HF_API_KEY=hf_your_hugging_face_token
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional order. Unlisted configured providers follow.
AI_PROVIDER_ORDER=groq,gemini,openrouter,hf
# Each account's quota and billing plan still apply; this app never changes billing.
